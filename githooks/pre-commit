#!/usr/bin/env bash
# Refuses to commit personal material into the public repo.
#
# .gitignore is not a guard. It stops accidents of omission -- `git add -A`
# skipping what it should skip -- and nothing else. It does not survive
# `git add -f`, an edited ignore rule, a tool that stages files directly, or a
# path nobody thought to list. This does, because it inspects what is actually
# staged, at the last moment before it becomes history.
#
# That matters more here than in most repos: the remote is public, and git
# history is permanent. A personal file committed and pushed is not fixed by
# deleting it in the next commit.
#
# Enable with:  git config core.hooksPath githooks
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

blocked=""

# 1. Paths that are the user's by definition.
#
# ONE RULE, as of 2026-08-25: everything the user owns lives under vault/.
#
# This block used to name five paths with three carve-outs added one filename at
# a time -- and the rule they carved out of, tools/radar/*.json, had already
# silently swallowed two files that needed to ship. A list maintained by hand
# fails the moment somebody adds a file and does not think to update it. A
# boundary does not.
# The one exception is a README. The vault's folders ship so that somebody who
# downloads this knows where to put their CV without reading documentation
# first, and a folder with no explanation in it is a question, not an answer.
# Those READMEs are the system's words about the folder, never the user's words
# in it -- and they are still scanned by the content heuristic below, so a
# personal note pasted into one is caught by rule 2 rather than waved through.
#
# The six are named exactly. A wildcard over any-folder-slash-README was tried
# first and is wrong: the agent writes README files inside vault folders while it
# works, and the wildcard waved every one of them through.
while IFS= read -r f; do
  case "$f" in
    vault/README.md|vault/sources/README.md|vault/settings/README.md|\
    vault/secrets/README.md|vault/migration/README.md|vault/temp/README.md) ;;
    vault/*)
      blocked+="  $f  (vault/ is the user's, and must never be committed)"$'\n' ;;
  esac
done <<< "$staged"

# 2. Content that looks personal wherever it sits. Cheap heuristics, deliberately
#    noisy -- a false positive costs one --no-verify; a false negative is public.
for f in $staged; do
  [ -f "$f" ] || continue
  case "$f" in
    *.png|*.jpg|*.pdf|*.docx|*.zip) continue ;;
    # This file, and the docs describing it, necessarily contain the patterns
    # they look for. Scanning them flags the guard as its own violation.
    githooks/*|CONTRIBUTING.md|PRIVACY.md) continue ;;

    # System directories: written ABOUT users, never BY them.
    #
    # This is the same reasoning as the line above, applied one step wider. The
    # heuristic below matches phrases like "current salary" -- which is exactly
    # the phrasing guidance about pay disclosure needs, and to a regex, advice
    # telling somebody NOT to state a figure is indistinguishable from somebody
    # stating one. It fired twice on 2026-08-25: once on a skill file, then again
    # on the backlog entry written to describe the first.
    #
    # Both were fixed by rewording rather than overriding, which is the right
    # first response and does not scale: the next person reaches for
    # --no-verify, and routine overriding is how a good check stops being one.
    #
    # THE SCOPE IS DELIBERATE AND NARROW. A user's own material never lands in
    # these three directories -- it lives in wiki/ and sources/, which this rule
    # still scans and which .gitignore already blocks. Widening it further, or
    # to a filename, is what let search.example.json through with a real
    # person's home county in it. Do not.
    .claude/skills/*|templates/*|tools/*) continue ;;
  esac
  hits=$(grep -nEi \
    -e '[A-Za-z0-9._%+-]+@(gmail|outlook|hotmail|yahoo|icloud|proton)\.[a-z]+' \
    -e 'linkedin\.com/in/[a-z0-9-]+' \
    -e '\b(my salary|current salary|salary floor is|notice period is)\b' \
    "$f" 2>/dev/null | head -3 || true)
  if [ -n "$hits" ]; then
    blocked+="  $f  -- looks personal:"$'\n'
    while IFS= read -r h; do blocked+="      ${h:0:110}"$'\n'; done <<< "$hits"
  fi
done

# 3. State some OTHER tool dropped beside the code, naming the user's files.
#
#    .obsidian/ sat at the repository root, untracked but not ignored, and its
#    workspace.json recorded open files BY PATH -- naming vault settings and wiki
#    pages. One `git add -A` would have published that list to a public remote.
#
#    Rules 1 and 2 both missed it and neither was malfunctioning: rule 1 blocks
#    staged paths under vault/ and this was not under vault/; rule 2 looks for
#    emails, LinkedIn URLs and salary phrasing, and a JSON file listing PATHS
#    matches none of them. The guards covered the agent, not the desk.
#
#    Reported here rather than blocked on its own, because the offending file is
#    not in this commit -- it is the NEXT `git add -A` that publishes it. Blocking
#    is still right: staged is the last moment before history.
if command -v python3 >/dev/null 2>&1 && [ -f tools/foreign_state.py ]; then
  foreign=$(python3 tools/foreign_state.py --quiet 2>/dev/null) || true
  if [ -n "$foreign" ]; then
    blocked+="$foreign"$'\n'
  fi
fi

if [ -n "$blocked" ]; then
  cat >&2 <<EOF

  ┌──────────────────────────────────────────────────────────────────────┐
  │  COMMIT BLOCKED -- this looks like personal material                 │
  └──────────────────────────────────────────────────────────────────────┘

$blocked
  This repo is public and git history is permanent. A personal file that is
  committed and pushed is not fixed by deleting it in a later commit.

  If this is genuinely template or example content, unstage the real thing and
  commit a fictional version instead. Placeholder emails should use example.com.

  To override, if you are certain:   git commit --no-verify

EOF
  exit 1
fi
exit 0
